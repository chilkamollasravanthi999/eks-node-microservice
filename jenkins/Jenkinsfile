pipeline {

    agent any  // Using 'any' to avoid Kubernetes plugin issues

    environment {
        AWS_REGION = 'ap-south-1'
        ECR_REPO = '891970965031.dkr.ecr.ap-south-1.amazonaws.com/node-microservice'
        KUBECONFIG = '/root/.kube/config'  // path for EKS config
    }

    stages {

        stage('Clone Repo') {
            steps {
                git 'https://github.com/chilkamollasravanthi999/eks-node-microservice.git'
            }
        }

        stage('Build & Push Image') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'aws-creds',
                    usernameVariable: 'AWS_ACCESS_KEY_ID',
                    passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                )]) {
                    sh '''
                    # Configure AWS CLI credentials
                    mkdir -p /root/.aws
                    cat > /root/.aws/credentials <<EOF
[default]
aws_access_key_id = $AWS_ACCESS_KEY_ID
aws_secret_access_key = $AWS_SECRET_ACCESS_KEY
EOF

                    # Login to ECR (for Kaniko or Docker)
                    aws ecr get-login-password --region $AWS_REGION | docker login --username AWS --password-stdin $ECR_REPO

                    # Build & push Docker image using Kaniko
                    /kaniko/executor \
                        --context $WORKSPACE \
                        --dockerfile $WORKSPACE/Dockerfile \
                        --destination $ECR_REPO:latest \
                        --skip-tls-verify
                    '''
                }
            }
        }

        stage('Configure kubectl for EKS') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'aws-creds',
                    usernameVariable: 'AWS_ACCESS_KEY_ID',
                    passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                )]) {
                    sh '''
                    # Update kubeconfig for EKS
                    aws eks update-kubeconfig \
                        --region $AWS_REGION \
                        --name <your-eks-cluster-name> \
                        --kubeconfig $KUBECONFIG
                    '''
                }
            }
        }

        stage('Deploy to EKS') {
            steps {
                sh '''
                # Deploy Helm chart
                helm upgrade --install nodeapp helm/nodeapp --kubeconfig $KUBECONFIG
                '''
            }
        }

    }

}